# EukaHub web — production image: build the SPA, then serve it with nginx
# (which also proxies /api to the api service; see nginx.conf).

# --- build stage -------------------------------------------------------------
# Debian (glibc), not alpine (musl): the committed package-lock.json is resolved
# on glibc, so installing on alpine can miss Rollup/esbuild's musl native deps.
FROM node:22-slim AS build
WORKDIR /app
# Install deps from the lockfile first (cached until package*.json changes).
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

# --- serve stage -------------------------------------------------------------
FROM nginx:alpine
# curl for the container healthcheck (busybox wget's behavior here is unreliable).
RUN apk add --no-cache curl
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
# nginx:alpine's default CMD runs nginx in the foreground.
