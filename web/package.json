{
  "name": "eukahub-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "gen:openapi": "cd .. && uv run --package eukahub-api python -m eukahub_api.export_openapi web/src/api/openapi.json",
    "gen:api": "openapi-typescript ./src/api/openapi.json -o ./src/api/schema.ts",
    "gen": "npm run gen:openapi && npm run gen:api"
  },
  "dependencies": {
    "d3-hierarchy": "^3.1.2",
    "d3-shape": "^3.2.0",
    "openapi-fetch": "^0.13.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-shape": "^3.1.8",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.5.3",
    "vite": "^8.2.0"
  }
}
