# EukaHub — environment template.
#
# Copy to infra/.env (gitignored) and set real values for staging/prod:
#     cp infra/.env.example infra/.env
#
# For LOCAL DEV you can ignore this entirely — docker-compose.yml falls back to
# the "eukahub" dev defaults via ${VAR:-default}, so the stack runs with no .env.
#
# To apply overrides, point compose at the file explicitly:
#     docker compose -f infra/docker-compose.yml --env-file infra/.env up -d
#
# NEVER commit infra/.env with real credentials — it is gitignored on purpose.

# Postgres credentials (the api service builds DATABASE_URL from these).
# The production stack refuses to start without a password. Use letters and
# digits only, since it is embedded in a connection URL; for example:
#     openssl rand -hex 24
POSTGRES_USER=eukahub
POSTGRES_PASSWORD=
POSTGRES_DB=eukahub

# Only needed when running the API/pipeline NATIVELY (uvicorn / python -m build)
# instead of via compose — those read DATABASE_URL directly (default targets the
# compose Postgres on localhost). Uncomment and set for a non-default DB:
# DATABASE_URL=postgresql://eukahub:<password>@localhost:5432/eukahub

# API CORS allowlist (comma-separated origins). The SPA calls /api same-origin
# via the proxy, so this is only needed if browsers hit the API cross-origin.
# CORS_ALLOW_ORIGINS=https://your-web-host

# How long GET responses may be cached downstream (seconds); tune to the
# offline-rebuild cadence. Default 3600.
# CACHE_MAX_AGE=3600

# Postgres cancels any API query slower than this (milliseconds), so a single
# expensive request can't monopolize a small server's CPU. Default 15000.
# DB_STATEMENT_TIMEOUT_MS=15000

# Most database connections the API holds at once. Default 4 (sized for a
# one-core host; raise it on bigger hardware).
# DB_POOL_MAX=4

# Rows per chunk of a TSV download (1000 to 10000). Larger is slightly faster and
# costs about 1 MB of API memory per 1,000 rows, per download running at once.
# EXPORT_BATCH_ROWS=5000

# Python log level for the API (JSON lines on stdout). Default INFO.
# LOG_LEVEL=INFO

# Deployment settings. Each one is optional: unset or empty keeps the default,
# and an invalid value is logged by the API and replaced by its default. Apply a
# change with `docker compose ... up -d api`; browsers and the nginx cache may keep
# the old values for up to CACHE_MAX_AGE seconds. Links must be https:// URLs.

# "Open at the source" links on taxon pages; {taxid} is replaced by the taxon id.
# The two RNA-Seq defaults are ENA advanced searches over the taxon's subtree
# (full text in core/src/eukahub_core/metrics.py).
# ASSEMBLY_LINK_TEMPLATE=https://www.ncbi.nlm.nih.gov/datasets/genome/?taxon={taxid}
# ANNOTATION_LINK_TEMPLATE=https://genome.crg.es/annotrieve/annotations/?taxids={taxid}
# RNA_SEQ_LINK_TEMPLATE=
# LONG_READ_LINK_TEMPLATE=

# Header links: the feedback form and the source code.
# FEEDBACK_URL=https://docs.google.com/forms/d/e/1FAIpQLSfEEOn9g8c1G14DLkRr9qlMQldLdibyVO7zotzkIT4PKYgMKQ/viewform
# SOURCE_CODE_URL=https://github.com/Cobos-Bioinfo/EukaHub

# Data protection contact shown on the Privacy page. Set it to the address of
# whoever runs this server.
# PRIVACY_CONTACT_EMAIL=placeholder@crg.eu

# Wikipedia "About" summaries. Wikipedia asks for a User-Agent that says how to
# reach the operator; the default names SOURCE_CODE_URL. The timeout is 1 to 30 s.
# WIKIPEDIA_SUMMARY_URL=https://en.wikipedia.org/api/rest_v1/page/summary/{title}
# WIKIPEDIA_USER_AGENT=EukaHub/1.0 (https://github.com/Cobos-Bioinfo/EukaHub)
# WIKIPEDIA_TIMEOUT_SECONDS=6

# Curated groups (labels, "Surprise me", landing-page cards) are not set here:
# copy infra/config/groups.example.json to infra/config/groups.json, edit it, and
# restart the api service (docs/deployment.md#curated-groups).

# Repository whose dataset Releases the refresher installs (owner/name).
# Keep the default to use the upstream data, or point it at a fork that runs
# its own rebuild workflow (see docs/deployment.md).
# EUKAHUB_REPO=Cobos-Bioinfo/EukaHub

# Seconds between the refresher's checks for a newer Release. Default 86400.
# REFRESH_INTERVAL=86400
