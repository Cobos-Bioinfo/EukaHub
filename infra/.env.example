# EukaHub — environment template.
#
# Copy to infra/.env (gitignored) and set real values for staging/prod:
#     cp infra/.env.example infra/.env
#
# For LOCAL DEV you can ignore this entirely — docker-compose.yml falls back to
# the "eukahub" dev defaults via ${VAR:-default}, so the stack runs with no .env.
#
# To apply overrides, point compose at the file explicitly:
#     docker compose -f infra/docker-compose.yml --env-file infra/.env up -d
#
# NEVER commit infra/.env with real credentials — it is gitignored on purpose.

# Postgres credentials (the api service builds DATABASE_URL from these).
# The production stack refuses to start without a password. Use letters and
# digits only, since it is embedded in a connection URL; for example:
#     openssl rand -hex 24
POSTGRES_USER=eukahub
POSTGRES_PASSWORD=
POSTGRES_DB=eukahub

# Only needed when running the API/pipeline NATIVELY (uvicorn / python -m build)
# instead of via compose — those read DATABASE_URL directly (default targets the
# compose Postgres on localhost). Uncomment and set for a non-default DB:
# DATABASE_URL=postgresql://eukahub:<password>@localhost:5432/eukahub

# API CORS allowlist (comma-separated origins). The SPA calls /api same-origin
# via the proxy, so this is only needed if browsers hit the API cross-origin.
# CORS_ALLOW_ORIGINS=https://your-web-host

# How long GET responses may be cached downstream (seconds); tune to the
# offline-rebuild cadence. Default 3600.
# CACHE_MAX_AGE=3600

# Postgres cancels any API query slower than this (milliseconds), so a single
# expensive request can't monopolize a small server's CPU. Default 15000.
# DB_STATEMENT_TIMEOUT_MS=15000

# Most database connections the API holds at once. Default 4 (sized for a
# one-core host; raise it on bigger hardware).
# DB_POOL_MAX=4

# Python log level for the API (JSON lines on stdout). Default INFO.
# LOG_LEVEL=INFO

# Repository whose dataset Releases the refresher installs (owner/name).
# Keep the default to use the upstream data, or point it at a fork that runs
# its own rebuild workflow (see docs/deployment.md).
# EUKAHUB_REPO=Cobos-Bioinfo/EukaHub

# Seconds between the refresher's checks for a newer Release. Default 86400.
# REFRESH_INTERVAL=86400
